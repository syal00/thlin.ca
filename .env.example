APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Current supported database scope: file-backed local SQLite.
# Leave DB_DATABASE unset to use database/database.sqlite from config/database.php.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/thlin.ca/database/database.sqlite
DB_FOREIGN_KEYS=true
# Do not add external database credentials, DATABASE_URL, or DATABASE_DIRECT_URL
# for the current SQLite demo and local-development scope.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="notifications@thehealthline.ca"
MAIL_FROM_NAME="THLIN CMS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# THLIN admin (config/admin.php) — main CMS manager account
THLIN_ADMIN_NAME="Daniel Walker"
THLIN_ADMIN_EMAIL=daniel.walker@thehealthline.ca
THLIN_ADMIN_PASSWORD=Security123!
THLIN_ADMIN_MAX_USERS=10
# Developer and team accounts are added as secondary admins from Admin Users.

# Mail (client-owned — Daniel / THLIN sets this up at handover, not the developer)
# Free option: Resend https://resend.com/signup (3,000 emails/month)
# 1. Daniel (or THLIN IT) creates the Resend account with a @thehealthline.ca email
# 2. Verify domain thehealthline.ca in Resend (DNS records)
# 3. Create an API key in Resend → add to Vercel env vars (never commit the key)
# 4. Uncomment on production / Vercel:
# MAIL_MAILER=resend
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS=notifications@thehealthline.ca
# MAIL_FROM_NAME="THLIN CMS"
#
# Local dev: keep MAIL_MAILER=log (default). Forgot-password shows a reset link on screen.

# TinyMCE — self-hosted (default, free, no API key). Only needed if TINYMCE_SELF_HOSTED=false.
TINYMCE_SELF_HOSTED=true
# TINYMCE_API_KEY=

# Cloudinary — required in production for persistent admin uploads on Vercel.
# Leave this commented out locally: CloudinaryStorage falls back to local
# public-disk storage when it's unset, which is what you want for dev/test.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
