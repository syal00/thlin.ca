APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Current supported database scope: file-backed local SQLite.
# Leave DB_DATABASE unset to use database/database.sqlite from config/database.php.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/thlin.ca/database/database.sqlite
DB_FOREIGN_KEYS=true
# Do not add external database credentials, DATABASE_URL, or DATABASE_DIRECT_URL
# for the current SQLite demo and local-development scope.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# THLIN admin (config/admin.php)
THLIN_ADMIN_NAME="Site Administrator"
THLIN_ADMIN_EMAIL=you@example.com
THLIN_ADMIN_PASSWORD=changeme
# Mail — contact form and notifications. Use log locally (storage/logs/laravel.log).
# For production, configure SMTP or a provider such as Mailgun, Postmark, or Resend.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@thehealthline.ca"
# MAIL_FROM_NAME="${APP_NAME}"

# TinyMCE — self-hosted (default). Set TINYMCE_SELF_HOSTED=false to use Tiny Cloud CDN.
TINYMCE_SELF_HOSTED=true
TINYMCE_API_KEY=your-key-here

# Cloudinary — required in production for persistent admin uploads on Vercel.
# Leave this commented out locally: CloudinaryStorage falls back to local
# public-disk storage when it's unset, which is what you want for dev/test.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
