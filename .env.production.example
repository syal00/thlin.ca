APP_NAME=THLIN
APP_ENV=production
APP_DEBUG=false
APP_URL=https://thlin.ca

# Configure real values in Vercel Project Settings. Do not commit credentials.
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_SSLMODE=require

# Vercel Blob read-write token for the connected Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# Vercel runtime is stateless; these stores must not use the application database.
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
