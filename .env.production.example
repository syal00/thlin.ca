APP_NAME=THLIN
APP_ENV=production
APP_DEBUG=false
APP_URL=https://thlin.ca

# Current scope is the bundled SQLite demonstration database. Do not add
# PostgreSQL, Neon, SQL Server, DATABASE_URL, or DATABASE_DIRECT_URL values.
# Leaving DB_DATABASE unset uses database/database.sqlite from config/database.php.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/thlin.ca/database/database.sqlite
DB_FOREIGN_KEYS=true

# Vercel has no durable shared filesystem for SQLite writes. Treat deployed CMS
# writes as non-durable; use a separately approved SQL Server migration for
# persistent multi-user editing.

# Vercel Blob read-write token for the connected Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# Vercel runtime is stateless; these stores must not use the application database.
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
